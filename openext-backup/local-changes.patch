   return navId ? `${base}/${encodeURIComponent(navId)}` : base;
 }
 
+/**
+ * Orders visible nav pages for the sidebar: each nested page directly after its parent.
+ * A page whose parent is not visible (e.g. hidden by role page access) is treated as top-level.
+ */
+export function orderAdminNavForSidebar(
+  pages: PluginAdminNavItem[]
+): Array<{ item: PluginAdminNavItem; parentId?: string }> {
+  const visibleIds = new Set(pages.map((item) => item.id));
+  const isNested = (item: PluginAdminNavItem) =>
+    Boolean(item.parent && item.parent !== item.id && visibleIds.has(item.parent));
+  return pages
+    .filter((item) => !isNested(item))
+    .flatMap((top) => [
+      { item: top },
+      ...pages
+        .filter((child) => isNested(child) && child.parent === top.id)
+        .map((child) => ({ item: child, parentId: top.id })),
+    ]);
+}
