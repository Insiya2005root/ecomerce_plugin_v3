+/**
+ * Fields a logged-out visitor needs to render plugin blocks on public pages (PluginContext registers
+ * blocks from these). Admin pages, server entry, permissions, hooks and errors are never sent.
+ */
+const PUBLIC_BLOCK_FIELDS = [
+  'pluginId',
+  'name',
+  'version',
+  'description',
+  'icon',
+  'type',
+  'kind',
+  'isActive',
+  'entryPoint',
+  'blockEntry',
+  'customElement',
+  'styles',
+  'source',
+] as const;
+
+function toPublicBlockPlugin(plugin: { toObject?: () => unknown }) {
+  const row = (typeof plugin.toObject === 'function' ? plugin.toObject() : plugin) as Record<string, unknown>;
+  return Object.fromEntries(PUBLIC_BLOCK_FIELDS.filter((k) => row[k] !== undefined).map((k) => [k, row[k]]));
+}
 
